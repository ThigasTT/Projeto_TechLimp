{
  "expo": {
    "name": "tlc_TCC",
    "slug": "techlimp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techlimp.tlctcc",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.techlimp.tlctcc"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "techlimp",
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleMapsApiKey": "AIzaSyCuDnr5yC3bqZhwqvF2nZLfkTPDlNBGm-Y",
      "router": {},
      "eas": {
        "projectId": "fe3fa9d8-62ee-4e56-b3b1-ebd39a25047d"
      }
    },
    "owner": "lucasz.xx7"
  }
}